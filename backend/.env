# QuakeRoute Environment Configuration
# Copy this file to .env and fill in your values

# Application
APP_NAME=quantum-disaster-system
ENV=dev
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Database
DB_HOST=localhost
DB_PORT=5433
DB_NAME=quantum_disaster
DB_USER=postgres
DB_PASSWORD=password

# Alternative: Full connection URL (overrides individual settings)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/quantum_disaster

# External APIs
OSRM_BASE_URL=https://router.project-osrm.org
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Resource Discovery
RESOURCE_SEARCH_RADIUS_KM=15
RESOURCE_DISCOVERY_LIMIT=50

# Logging
LOG_LEVEL=INFO
